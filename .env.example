# Job Scraper Login Credentials
# Fill in your logins for sites that require authentication.
# The scraper will use these to log in and scrape job listings.

# LinkedIn (REQUIRED for best results)
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASS=your_linkedin_password

# Indeed (optional, helps with more results)
INDEED_EMAIL=your_indeed_email@example.com
INDEED_PASS=your_indeed_password
